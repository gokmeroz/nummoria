# Mobile (Expo) configuration. EXPO_PUBLIC_* values are bundled into the app
# — never put secrets here.
#
# Optional in development: without it, src/lib/api.js uses the Expo dev
# server's host on port 4000 (Android emulator: 10.0.2.2:4000). Set it when
# your phone can't reach that address. Production builds use
# https://api.nummoria.com.
EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
