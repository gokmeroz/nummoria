# Nummoria backend — example configuration.
#
#   cp .env.example .env
#
# Only the REQUIRED block is needed to boot the API locally. Everything else
# enables an optional feature; leaving it empty disables that feature, as
# noted per block. Never commit a real .env (it is gitignored).
#
# Tests (`npm test`) never read this file: NODE_ENV=test skips dotenv, and
# tests set the few variables they need themselves.

# ── REQUIRED ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# server.js refuses to start without these two. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
REGISTRATION_TOKEN_SECRET=replace-with-a-different-long-random-string
# Local MongoDB (or a dev Atlas cluster). Used when NODE_ENV != production.
MONGO_URI=mongodb://127.0.0.1:27017/nummoria_dev

# ── URLs / CORS (defaults shown are what the code falls back to in dev) ───
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Production-only overrides (NODE_ENV=production):
# FRONTEND_URL_PROD=
# BACKEND_URL_PROD=
# MONGO_URI_PROD=
# DB_TARGET=prod            # forces MONGO_URI_PROD even outside production; has safety checks
# TRUST_PROXY=true          # behind a load balancer
# BACKEND_DOMAIN=           # cookie domain in production
# COOKIE_NAME=nummoria_token
# COOKIE_SAMESITE=lax       # none|lax|strict
# BODY_LIMIT=200kb
# PUBLIC_BASE_URL=          # absolute base for avatar URLs; defaults to the request host

# ── Redis (optional for the API, required for the workers) ─────────────────
# Used by: transaction reminders (BullMQ queue), push notifications, and the
# per-user AI quota counter. The API starts without Redis: queues connect
# lazily on first use, reminder scheduling failures are logged and do not
# block transaction writes, and the AI quota falls back to an in-memory
# counter. `npm run worker` needs a reachable Redis.
REDIS_URL=redis://127.0.0.1:6379
# Legacy alternative to REDIS_URL (ignored when REDIS_URL is set):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── AI providers (optional) ────────────────────────────────────────────────
# Without a key the advisor answers with its rule-based engine, and statement
# extraction stays on the deterministic parser. Tests and `npm run eval`
# never need these.
FINANCIAL_HELPER_AGENT=gemini   # gemini | openai (default when unset: openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Let low-confidence PDF statements escalate to the model tier on the advisor
# upload route. Off by default; spends quota and money when on.
EXTRACTION_ESCALATION=off
# Model-tier timeout for statement extraction, in ms.
# EXTRACTION_MODEL_TIMEOUT_MS=30000

# ── AI tracing (optional; defaults shown) ──────────────────────────────────
# AI_TRACING_ENABLED=true
# AI_TRACE_STORE_PAYLOADS=true   # raw prompts/outputs; redacted only when NODE_ENV=production
# AI_TRACE_PAYLOAD_TTL_DAYS=30

# ── Market data (optional) ─────────────────────────────────────────────────
ENABLE_QUOTES=true              # npm run dev / start already set this
FMP_API_KEY=                    # analyst consensus; feature reports "not configured" without it

# ── Auth: development shortcuts ────────────────────────────────────────────
AUTH_SKIP_EMAIL_VERIFICATION=true
DEBUG_VERIFY=true               # print verification codes to the console
# DEV_VERIFICATION_CODE=000000
# FORCE_EMAIL_SEND=false        # true = actually send verification email

# ── OAuth (optional; each provider is disabled without its credentials) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# GOOGLE_REDIRECT_URI_PROD=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=       # base64 of the .p8 file (or APPLE_PRIVATE_KEY raw)
APPLE_REDIRECT_URI=
APPLE_IOS_BUNDLE_ID=
APPLE_ALLOWED_AUDIENCES=

# ── Email (optional) ───────────────────────────────────────────────────────
# Verification email via the Gmail API (required only in production).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_API_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_SENDER=
MAIL_FROM=
# Contact form transport: gmail (CONTACT_EMAIL + CONTACT_PASS app password) or mailtrap.
EMAIL_PROVIDER=
CONTACT_EMAIL=
CONTACT_PASS=
CONTACT_RECEIVER=
MAILTRAP_USER=
MAILTRAP_PASS=
# Renewal reminder emails (jobs/renewalReminders.js)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
# SMTP_URL=                     # admin user emails

# ── Receipt OCR (optional) ─────────────────────────────────────────────────
# Requires the `tesseract` binary on PATH.
# OCR_LANGS=eng                 # e.g. eng+tur

# ── Rate limits (optional; defaults in app.js) ─────────────────────────────
# RATE_WINDOW_MS=900000
# RATE_MAX=
# RATE_LOGIN_MAX=
# RATE_AI_MAX=
# RATE_QUOTE_MAX=
# RATE_CONTACT_MAX=10

# ── Debug ──────────────────────────────────────────────────────────────────
# DEBUG_TX_CREATE=true
