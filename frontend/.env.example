# Web app configuration. Vite exposes VITE_* values to the browser — never
# put secrets here.
#
# Local dev needs no .env: src/lib/api.js falls back to http://localhost:4000.
# Production builds read .env.production (committed, public URL).
# To point a local dev server elsewhere: cp .env.example .env.local
VITE_API_URL=http://localhost:4000
